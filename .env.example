# Copy to .env. One env file serves the backend, the frontend and start_app.sh.

BACKEND_PORT=8040
FRONTEND_PORT=3040

# Browsers allowed to call the API (comma-separated origins).
FRONTEND_ORIGINS=http://localhost:3040,http://127.0.0.1:3040

# Speech to text. The first start downloads the weights (~1.2 GB).
STT_MODEL=mlx-community/parakeet-tdt-0.6b-v2
STT_PRELOAD=true
MAX_AUDIO_SECONDS=120

# Text to speech. The first start downloads the weights (~330 MB).
TTS_VOICE=af_heart
TTS_SPEED=1.0
# cpu (fastest for short answers), mps (Apple GPU) or auto.
TTS_DEVICE=cpu
TTS_PRELOAD=true

# Claude: each question runs `claude -p` with these flags. ASK_*, not CLAUDE_*,
# because Claude Code sets CLAUDE_EFFORT etc. in the shells it starts.
ASK_CLI=claude
ASK_MODEL=sonnet
ASK_EFFORT=low
ASK_TIMEOUT_SECONDS=120
ASK_WORKDIR=~/.jarvis_local/workspace
# Empty = no tools: Claude only answers.
ASK_TOOLS=
# true = skip your user settings (hooks), MCP servers and skills: faster.
ASK_ISOLATED=true
